# Tradify Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ============================================================================
# API Configuration
# ============================================================================

# Backend API base URL
EXPO_PUBLIC_API_URL=https://api.tradify.local

# API timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT=30000

# ============================================================================
# Paystack Configuration
# ============================================================================

# Paystack public key (get from dashboard.paystack.com)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Paystack test/live mode
PAYSTACK_ENV=test

# ============================================================================
# Firebase Configuration (optional - for analytics/auth)
# ============================================================================

# FIREBASE_API_KEY=xxxxx
# FIREBASE_AUTH_DOMAIN=xxxxx.firebaseapp.com
# FIREBASE_PROJECT_ID=xxxxx
# FIREBASE_STORAGE_BUCKET=xxxxx.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=xxxxx
# FIREBASE_APP_ID=xxxxx
# FIREBASE_MEASUREMENT_ID=xxxxx

# ============================================================================
# Application Features
# ============================================================================

# Enable Paystack escrow payment option
ENABLE_PAYSTACK_ESCROW=true

# Enable offline operation queue
ENABLE_OFFLINE_QUEUE=true

# Enable debug logging
DEBUG=tradify:*

# ============================================================================
# Build Configuration
# ============================================================================

# EAS Build Project ID (get from eas.json or create at expo.dev)
# EAS_PROJECT_ID=xxxxx

# Staging vs Production
ENVIRONMENT=development

# ============================================================================
# Database Configuration (local only - WatermelonDB)
# ============================================================================

# WatermelonDB file name
WATERMELON_DB_NAME=tradify_db

# ============================================================================
# Feature Flags
# ============================================================================

# Beta features
ENABLE_BETA_FEATURES=false

# Analytics
ENABLE_ANALYTICS=true

# Crash reporting
ENABLE_CRASH_REPORTING=true
