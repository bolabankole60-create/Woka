# ============================================================================
# TRADIFY BACKEND - Environment Configuration
# Copy this file to .env.local or .env.production and fill in your values
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================

# Node environment: development, staging, production
NODE_ENV=development

# Server port
PORT=3000

# API base URL (for CORS, webhooks, etc.)
API_URL=http://localhost:3000

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# For local Docker: postgresql://tradify:tradify@localhost:5432/tradify_db
DATABASE_URL=postgresql://tradify:tradify@localhost:5432/tradify_db

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# JWT secret key (generate with: openssl rand -base64 32)
# Must be at least 32 characters in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiry times
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# ============================================================================
# PAYSTACK (Payment Processing)
# ============================================================================

# Paystack secret key
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Paystack public key (for client-side)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# LOGGING
# ============================================================================

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Log format: json, text
LOG_FORMAT=text

# ============================================================================
# CORS & SECURITY
# ============================================================================

# Allowed origins for CORS (comma-separated)
# Examples: http://localhost:19006,http://192.168.1.100:19006,https://app.tradify.ng
CORS_ORIGINS=http://localhost:19006,http://192.168.1.100:19006

# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# MOBILE APP
# ============================================================================

# Your local machine IP for mobile testing
# Find with: ipconfig (Windows) or ifconfig (Mac/Linux)
MOBILE_TEST_IP=192.168.1.100

# ============================================================================
# EMAIL (Optional - for future notifications)
# ============================================================================

# SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# From email address
MAIL_FROM=noreply@tradify.ng

# ============================================================================
# STORAGE (Optional - for file uploads)
# ============================================================================

# AWS S3 or alternative storage
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET=tradify-uploads

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry error tracking (optional)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Database: seed with sample data on startup
SEED_DATABASE=true

# Database: reset on startup (dangerous! only for development)
RESET_DATABASE=false

# Mock Paystack webhook responses (development only)
MOCK_PAYSTACK=true

# ============================================================================
# NOTES FOR PRODUCTION
# ============================================================================

# Before deploying to production:
# 1. Generate a strong JWT_SECRET: openssl rand -base64 32
# 2. Use a managed PostgreSQL database (AWS RDS, Google Cloud SQL, etc.)
# 3. Set NODE_ENV=production
# 4. Enable HTTPS for API_URL
# 5. Add real Paystack keys
# 6. Configure CORS_ORIGINS to your production domain
# 7. Enable rate limiting
# 8. Set up proper logging/monitoring
# 9. Use environment-specific secrets management (AWS Secrets Manager, etc.)
