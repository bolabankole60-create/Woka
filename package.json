{
  "name": "tradify",
  "version": "0.1.0",
  "description": "Offline-first mobile app for Nigerian artisans and SMEs",
  "main": "expo-router/build/index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.27.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.8",
    "@react-navigation/native-stack": "^6.9.13",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "expo": "^51.0.0",
    "expo-constants": "^15.4.5",
    "expo-file-system": "^15.4.5",
    "expo-linking": "^6.0.2",
    "expo-network": "^5.7.0",
    "expo-router": "^3.4.8",
    "expo-secure-store": "^12.3.2",
    "expo-sharing": "^12.0.1",
    "expo-status-bar": "~1.11.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nativewind": "^2.0.11",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-reanimated": "^3.6.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-screens": "^3.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@prisma/client": "^5.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^26.1.1",
    "@types/react": "^18.2.37",
    "@types/react-native": "^0.72.8",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.1",
    "prettier": "^3.0.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "expo": {
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Tradify to use Face ID to secure your data."
        }
      ]
    ]
  }
}
