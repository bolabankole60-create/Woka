{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": false,
    "incremental": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/server.ts",
    "src/controllers/**/*.ts",
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts",
    "src/config/**/*.ts",
    "src/services/**/*.ts",
    "src/utils/**/*.ts",
    "src/db/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app",
    "src/screens",
    "src/hooks",
    ".expo"
  ]
}
